#!/usr/bin/env python3
"""
Sign the agent scripts so agents refuse an update that did not come from
the project's signing key.

    bbs-sign-agent keygen            create ~/.bbs/agent-signing.key and print the public key
    bbs-sign-agent sign [file...]    re-sign agent/bbs-agent.py and agent/bbs-agent-start.sh
    bbs-sign-agent verify [file...]  check the signatures against agent/signing-key.pub
    bbs-sign-agent selftest          run the Ed25519 implementation against RFC 8032

The signature is the last line of the file:

    # bbs-signature: v1 <base64 Ed25519 signature>

and covers every byte before that line. The agent carries the public key
and checks a downloaded update the same way (see _verify_signed_script in
agent/bbs-agent.py). A pre-commit hook in .githooks re-signs the scripts
whenever they are staged, so main is always signed.

The private key is a 32-byte seed, hex encoded, read from
$BBS_AGENT_SIGNING_KEY or ~/.bbs/agent-signing.key. It never leaves this
machine; keep a copy in your password manager.

Ed25519 is implemented here in plain Python so neither this tool nor the
agent needs a library. It is the reference construction from RFC 8032
with affine arithmetic, slow but correct, and signing a 250 KB file takes
well under a second.
"""
import base64
import binascii
import hashlib
import os
import stat
import sys

# ─── Ed25519 (RFC 8032), plain Python ───────────────────────────────────────

_Q = 2 ** 255 - 19
_L = 2 ** 252 + 27742317777372353535851937790883648493


def _inv(x):
    return pow(x, _Q - 2, _Q)


_D = (-121665 * _inv(121666)) % _Q
_I = pow(2, (_Q - 1) // 4, _Q)


def _xrecover(y):
    xx = (y * y - 1) * _inv(_D * y * y + 1)
    x = pow(xx, (_Q + 3) // 8, _Q)
    if (x * x - xx) % _Q != 0:
        x = (x * _I) % _Q
    if x % 2 != 0:
        x = _Q - x
    return x


_BY = (4 * _inv(5)) % _Q
_B = (_xrecover(_BY), _BY)


def _edwards(P, Q):
    x1, y1 = P
    x2, y2 = Q
    x3 = (x1 * y2 + x2 * y1) * _inv(1 + _D * x1 * x2 * y1 * y2)
    y3 = (y1 * y2 + x1 * x2) * _inv(1 - _D * x1 * x2 * y1 * y2)
    return (x3 % _Q, y3 % _Q)


def _scalarmult(P, e):
    if e == 0:
        return (0, 1)
    Q = _scalarmult(P, e // 2)
    Q = _edwards(Q, Q)
    if e & 1:
        Q = _edwards(Q, P)
    return Q


def _encodeint(y):
    return bytes(bytearray([(y >> (8 * i)) & 0xff for i in range(32)]))


def _encodepoint(P):
    x, y = P
    bits = bytearray(_encodeint(y))
    bits[31] |= (x & 1) << 7
    return bytes(bits)


def _decodeint(s):
    return sum(bytearray(s)[i] << (8 * i) for i in range(32))


def _decodepoint(s):
    b = bytearray(s)
    y = sum((b[i] if i < 31 else (b[31] & 0x7f)) << (8 * i) for i in range(32))
    x = _xrecover(y)
    if x & 1 != (b[31] >> 7):
        x = _Q - x
    P = (x, y)
    if not _oncurve(P):
        raise ValueError("point is not on the curve")
    return P


def _oncurve(P):
    x, y = P
    return (-x * x + y * y - 1 - _D * x * x * y * y) % _Q == 0


def _hint(m):
    return _decodeint(hashlib.sha512(m).digest()[:32]) + (_decodeint(hashlib.sha512(m).digest()[32:]) << 256)


def _secret_scalar(seed):
    h = bytearray(hashlib.sha512(seed).digest())
    h[0] &= 248
    h[31] &= 63
    h[31] |= 64
    return _decodeint(bytes(h[:32])), bytes(h[32:])


def ed25519_publickey(seed):
    a, _ = _secret_scalar(seed)
    return _encodepoint(_scalarmult(_B, a))


def ed25519_sign(message, seed):
    a, prefix = _secret_scalar(seed)
    pk = ed25519_publickey(seed)
    r = _hint(prefix + message) % _L
    R = _encodepoint(_scalarmult(_B, r))
    k = _hint(R + pk + message) % _L
    S = (r + k * a) % _L
    return R + _encodeint(S)


def ed25519_verify(signature, message, pk):
    if len(signature) != 64 or len(pk) != 32:
        return False
    try:
        R = _decodepoint(signature[:32])
        A = _decodepoint(pk)
    except ValueError:
        return False
    S = _decodeint(signature[32:])
    if S >= _L:
        return False
    k = _hint(signature[:32] + pk + message) % _L
    return _scalarmult(_B, S) == _edwards(R, _scalarmult(A, k))


# ─── Signature line handling ───────────────────────────────────────────────

MARKER = b"# bbs-signature: v1 "


def split_signed(data):
    """(message, signature bytes or None). The signature is the last line."""
    idx = data.rfind(b"\n" + MARKER)
    if idx < 0:
        return data, None
    line = data[idx + 1:].strip()
    try:
        sig = base64.b64decode(line[len(MARKER):])
    except (binascii.Error, ValueError):
        return data[:idx + 1], b""
    return data[:idx + 1], sig


def sign_file(path, seed):
    data = open(path, "rb").read()
    message, _ = split_signed(data)
    if not message.endswith(b"\n"):
        message += b"\n"
    sig = ed25519_sign(message, seed)
    with open(path, "wb") as f:
        f.write(message + MARKER + base64.b64encode(sig) + b"\n")


def verify_file(path, pks):
    data = open(path, "rb").read()
    message, sig = split_signed(data)
    if sig is None:
        return False, "no signature line"
    if not sig:
        return False, "signature line is not valid base64"
    for pk in pks:
        if ed25519_verify(sig, message, pk):
            return True, "ok"
    return False, "signature does not match any trusted key"


# ─── CLI ───────────────────────────────────────────────────────────────────

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_FILES = [os.path.join(ROOT, "agent", "bbs-agent.py"), os.path.join(ROOT, "agent", "bbs-agent-start.sh")]
PUBKEY_FILE = os.path.join(ROOT, "agent", "signing-key.pub")
KEY_FILE = os.environ.get("BBS_AGENT_SIGNING_KEY") or os.path.expanduser("~/.bbs/agent-signing.key")


def load_seed():
    if not os.path.exists(KEY_FILE):
        sys.exit("No signing key at {} (run: bbs-sign-agent keygen, or set BBS_AGENT_SIGNING_KEY)".format(KEY_FILE))
    seed = binascii.unhexlify(open(KEY_FILE).read().strip())
    if len(seed) != 32:
        sys.exit("Signing key must be 32 bytes, hex encoded")
    return seed


def load_pubkeys():
    keys = []
    if os.path.exists(PUBKEY_FILE):
        for line in open(PUBKEY_FILE):
            line = line.strip()
            if line and not line.startswith("#"):
                keys.append(binascii.unhexlify(line))
    if not keys:
        sys.exit("No public key in {}".format(PUBKEY_FILE))
    return keys


def selftest():
    # RFC 8032 section 7.1, test 1: empty message.
    seed = binascii.unhexlify("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    pk = binascii.unhexlify("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    sig = binascii.unhexlify("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
    assert ed25519_publickey(seed) == pk, "public key derivation"
    assert ed25519_sign(b"", seed) == sig, "signature"
    assert ed25519_verify(sig, b"", pk), "verify"
    assert not ed25519_verify(sig, b"x", pk), "verify must fail on a changed message"
    # RFC 8032 test 2: one-byte message with a different key.
    seed2 = binascii.unhexlify("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    pk2 = binascii.unhexlify("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
    sig2 = binascii.unhexlify("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
    assert ed25519_sign(b"\x72", seed2) == sig2, "signature 2"
    assert ed25519_verify(sig2, b"\x72", pk2), "verify 2"
    print("selftest ok")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    files = argv[2:] or DEFAULT_FILES
    if cmd == "selftest":
        selftest()
    elif cmd == "keygen":
        if os.path.exists(KEY_FILE):
            sys.exit("Refusing to overwrite {}".format(KEY_FILE))
        seed = os.urandom(32)
        os.makedirs(os.path.dirname(KEY_FILE), exist_ok=True)
        fd = os.open(KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, stat.S_IRUSR | stat.S_IWUSR)
        with os.fdopen(fd, "w") as f:
            f.write(binascii.hexlify(seed).decode() + "\n")
        pk = binascii.hexlify(ed25519_publickey(seed)).decode()
        print("Private key written to {} (mode 600). Back it up now.".format(KEY_FILE))
        print("Public key: {}".format(pk))
        print("Put it in {} and in AGENT_SIGNING_KEYS in agent/bbs-agent.py.".format(PUBKEY_FILE))
    elif cmd == "sign":
        seed = load_seed()
        pk = ed25519_publickey(seed)
        if pk not in load_pubkeys():
            sys.exit("The signing key's public key is not in {}".format(PUBKEY_FILE))
        for path in files:
            if not os.path.exists(path):
                continue
            sign_file(path, seed)
            print("signed {}".format(os.path.relpath(path, ROOT)))
    elif cmd == "verify":
        pks = load_pubkeys()
        bad = 0
        for path in files:
            if not os.path.exists(path):
                continue
            ok, why = verify_file(path, pks)
            print("{}: {}".format(os.path.relpath(path, ROOT), why))
            bad += 0 if ok else 1
        sys.exit(1 if bad else 0)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
