#!/bin/sh
# Re-sign the agent scripts whenever they are staged, so every commit on
# main carries a valid signature and agents accept the update. Needs the
# maintainer's signing key (see bin/bbs-sign-agent). Enable with:
#   git config core.hooksPath .githooks
set -e
changed=$(git diff --cached --name-only -- agent/bbs-agent.py agent/bbs-agent-start.sh)
[ -z "$changed" ] && exit 0
if ! python3 bin/bbs-sign-agent sign $changed; then
    echo "pre-commit: could not sign the agent scripts. Set BBS_AGENT_SIGNING_KEY or run bbs-sign-agent keygen." >&2
    exit 1
fi
git add $changed
